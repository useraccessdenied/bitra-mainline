+/*
+ * Image AX: read-only look at the USB controller (DWC3 at 0xa600000 on SM8250) in the state Mu leaves it: is it clocked (reads answer), which mode
+ * (GCTL.PRTCAPDIR 1 host / 2 device), is the device side running (DCTL.RUN_STOP, DSTS speed/connect), PHY configuration. Each register said before it
+ * is read, so a hang (clock gated) shows in the ring as the last line. Reads only.
+ */
+static void
+dwc3_probe(void)
+{
+	static const struct { uint32_t off; const char *name; } regs[] = {
+		{ 0xc120, "GSNPSID" }, { 0xc100, "GSBUSCFG0" }, { 0xc110, "GCTL" }, { 0xc118, "GSTS" }, { 0xc140, "GHWPARAMS0" }, { 0xc144, "GHWPARAMS1" },
+		{ 0xc148, "GHWPARAMS2" }, { 0xc14c, "GHWPARAMS3" }, { 0xc150, "GHWPARAMS4" }, { 0xc154, "GHWPARAMS5" }, { 0xc158, "GHWPARAMS6" },
+		{ 0xc15c, "GHWPARAMS7" }, { 0xc200, "GUSB2PHYCFG0" }, { 0xc2c0, "GUSB3PIPECTL0" }, { 0xc700, "DCFG" }, { 0xc704, "DCTL" },
+		{ 0xc708, "DEVTEN" }, { 0xc70c, "DSTS" }, { 0xc710, "DGCMDPAR" }, { 0xc720, "DALEPENA" },
+		{ 0xc400, "GEVNTADRLO0" }, { 0xc404, "GEVNTADRHI0" }, { 0xc408, "GEVNTSIZ0" }, { 0xc40c, "GEVNTCOUNT0" },
+	};
+
+	print("usb: DWC3 at a600000, read only\n");
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		print("usb: reading %s (+%x)\n", (uint64_t)(uintptr_t)regs[i].name, (uint64_t)regs[i].off);
+		print("usb: %s = %x\n", (uint64_t)(uintptr_t)regs[i].name, (uint64_t)*(volatile uint32_t *)(0x0a600000ULL + regs[i].off));
+	}
+	print("usb: done\n");
+}
+
+/*
+ * Image AX (tlmm_test=6): after AW (Mu's protocols write; PMIC device 2 = PM8150C: LDO1 = l1c 1.8 V avdd, LDO11 = l11c vdd; I2C instance 12 = the touch
+ * bus at 0xa94000; levels read in microvolts): the DWC3 probe first (reads), then the touch chip: enable l1c and l11c at the levels they already have (no
+ * SetLevel), reset gpio38 low 20 ms / high, then poll gpio39 (interrupt, active low) for 600 ms and read 4 bytes from 0x4b on instance 12 (a TouchComm
+ * message starts 0xa5 <code> <length lo> <length hi>) at 100 ms steps; then the same read on the other buses that open.
+ */
+static void
+delay_us(uint64_t us)
+{
+	uint64_t f, t0, now;
+
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r"(f));
+	__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(t0));
+	do {
+		__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(now));
+	} while ((now - t0) * 1000000ULL < us * f);
+}
