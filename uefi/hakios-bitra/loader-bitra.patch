+/*
+ * bitra: no log partition and no USB, so the kernel's log is shown on the panel in pages (the kernel's own console and
+ * UEFI's overdraw each other while it runs): the first PAGES_HEAD pages, then the last PAGES_TAIL, each cut to
+ * 100 characters a line, PAGE_LINES lines a page, PAGE_SECS seconds each, so that they can be photographed.
+ * The whole log is also printed to the loader's own log buffer (put_char), nothing is lost.
+ */
+#define PAGE_LINES 60
+#define PAGE_COLS 100
+#define PAGE_SECS 20
+#define PAGES_HEAD 3
+#define PAGES_TAIL 5
+
+static void
+show_log_page(const char *log, uint64_t len, uint64_t first_line, uint64_t page, uint64_t pages, const char *what)
+{
+	uint64_t line = 0, i = 0;
+
+	ST->con_out->clear_screen(ST->con_out);
+	print("== %s page %d of %d, kernel log lines from %d ==\n", what, page, pages, first_line);
+	while (i < len && line < first_line) {
+		if (log[i++] == '\n') {
+			line++;
+		}
+	}
+	for (uint64_t n = 0; n < PAGE_LINES && i < len; n++) {
+		uint64_t col = 0;
+
+		while (i < len && log[i] != '\n') {
+			if (col++ < PAGE_COLS && log[i] >= 32 && log[i] < 127) {
+				put_char(log[i]);
+			}
+			i++;
+		}
+		i++;
+		put_char('\n');
+	}
+	BS->stall((uint64_t)PAGE_SECS * 1000000ULL);
+}
+
+static void
+show_log_pages(const char *log, uint64_t len)
+{
+	uint64_t lines = 0;
+
+	for (uint64_t i = 0; i < len; i++) {
+		if (log[i] == '\n') {
+			lines++;
+		}
+	}
+	uint64_t total = (lines + PAGE_LINES - 1) / PAGE_LINES, tail_from = total > PAGES_HEAD + PAGES_TAIL ? total - PAGES_TAIL : PAGES_HEAD;
+
+	for (uint64_t p = 0; p < total && p < PAGES_HEAD; p++) {
+		show_log_page(log, len, p * PAGE_LINES, p + 1, total, "HEAD");
+	}
+	for (uint64_t p = tail_from; p < total; p++) {
+		show_log_page(log, len, p * PAGE_LINES, p + 1, total, "TAIL");
+	}
+	ST->con_out->clear_screen(ST->con_out);
+	print("kernel log: %d bytes, %d lines, %d pages shown, rebooting\n", len, lines, 0 + PAGES_HEAD + PAGES_TAIL);
+	BS->stall(10000000ULL);
+}
