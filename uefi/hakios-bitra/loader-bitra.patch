+/* ------------------------------------------------------------------------ */
+/* bitra: a gzip-compressed payload in the boot image. The firmware delivers only about 12.5 MiB of the decompressed */
+/* boot image intact (what lies past it reads as zeros), so the payload travels compressed and is inflated here.   */
+
+struct inf_huff {
+	uint16_t count[16];
+	uint16_t symbol[320];
