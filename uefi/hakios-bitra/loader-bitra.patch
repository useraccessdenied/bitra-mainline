+static void
+show_log_pages(const char *log, uint64_t len)
+{
+	uint64_t lines = 0;
+
+	for (uint64_t i = 0; i < len; i++) {
+		if (log[i] == '\n') {
+			lines++;
+		}
+	}
+	uint64_t total = (lines + PAGE_LINES - 1) / PAGE_LINES, tail_from = total > PAGES_HEAD + PAGES_TAIL ? total - PAGES_TAIL : PAGES_HEAD;
