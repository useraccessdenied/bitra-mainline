@@ -4295,6 +4372,49 @@ ramfb_phone_screen(void)
  * Only the kernel and a root image that fits in the payload come this way; the big Darwin system image does not
  * (docs/uefi-boot.md says what does).
  */
+/*
+ * bitra: the boot shim leaves the payload where the firmware's boot image was decompressed (a 15 MB copy with the MMU
+ * off never finished) and says where in a mailbox in the unused tail of the UEFI FD: { "XNUPSRC!", source, size }.
+ * Copy it to PAYLOAD_BASE now, with the caches on. Returns 1 if a payload was taken.
+ */
+#define BITRA_MAILBOX 0x9FEFF000ULL
+static const char *mailbox_note;
+
+static int
+load_payload_from_mailbox(void)
+{
+	volatile uint64_t *mb = (volatile uint64_t *)BITRA_MAILBOX;
+	uint64_t src, size, address = PAYLOAD_BASE;
+
+	if (mb[0] != 0x2143525350554E58ULL) {           /* "XNUPSRC!" */
+		return 0;
+	}
+	src = mb[1];
+	size = mb[2];
+	mb[0] = 0;
+	if (size < sizeof(struct payload_header) || size > PAYLOAD_MAX_SIZE - 0x100000ULL ||
+	    ((const struct payload_header *)(uintptr_t)src)->magic != PAYLOAD_MAGIC) {
+		mailbox_note = "the shim's mailbox does not point at a payload";
+		return 0;
+	}
+	if (EFI_ERROR(BS->allocate_pages(2 /* AllocateAddress */, 2 /* EfiLoaderData */, PAYLOAD_MAX_SIZE / 0x1000, &address))) {
+		mailbox_note = "the payload region is not free";
+		return 0;
+	}
+	print("bitra: payload source %x size %x\n", src, size);
+	for (uint64_t k = 0; k <= size / 0x100000; k++) {
+		uint64_t off = k < size / 0x100000 ? k * 0x100000 : size - 8;
+		print("  @%x %x\n", off, *(const uint64_t *)(uintptr_t)(src + off));
+	}
+	const uint64_t *from = (const uint64_t *)(uintptr_t)src;
+	uint64_t *to = (uint64_t *)(uintptr_t)PAYLOAD_BASE;
+	for (uint64_t i = 0; i < size / 8; i++) {
+		to[i] = from[i];
+	}
+	mailbox_note = "payload copied from the boot image";
+	return 1;
+}
