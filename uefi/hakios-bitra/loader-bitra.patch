+static const char *mailbox_note;
+
+static int
+load_payload_from_mailbox(void)
+{
+	volatile uint64_t *mb = (volatile uint64_t *)BITRA_MAILBOX;
+	uint64_t src, size, address = PAYLOAD_BASE;
+
+	if (mb[0] != 0x2143525350554E58ULL) {           /* "XNUPSRC!" */
+		return 0;
+	}
+	src = mb[1];
+	size = mb[2];
+	mb[0] = 0;
+	const uint8_t *srcb = (const uint8_t *)(uintptr_t)src;
+	int gz = size >= 18 && srcb[0] == 0x1f && srcb[1] == 0x8b;
+
+	if (size < sizeof(struct payload_header) || size > 0x4000000ULL ||
+	    (!gz && (size > PAYLOAD_MAX_SIZE - 0x100000ULL ||
+	    ((const struct payload_header *)(uintptr_t)src)->magic != PAYLOAD_MAGIC))) {
+		mailbox_note = "the shim's mailbox does not point at a payload";
+		return 0;
+	}
+	if (EFI_ERROR(BS->allocate_pages(2 /* AllocateAddress */, 2 /* EfiLoaderData */, PAYLOAD_MAX_SIZE / 0x1000, &address))) {
+		mailbox_note = "the payload region is not free";
+		return 0;
+	}
+	print("bitra: payload source %x size %x%s\n", src, size, gz ? " (gzip)" : "");
+	if (gz) {
+		const char *why = NULL;
+		uint64_t n = gunzip(srcb, size, (uint8_t *)(uintptr_t)PAYLOAD_BASE, PAYLOAD_MAX_SIZE, &why);
+
+		if (n == 0) {
+			mailbox_note = why;
+			return 0;
+		}
+		print("bitra: inflated %x bytes, CRC ok\n", n);
+		if (((const struct payload_header *)(uintptr_t)PAYLOAD_BASE)->magic != PAYLOAD_MAGIC) {
+			mailbox_note = "the inflated payload has no XNUP header";
+			return 0;
+		}
+		mailbox_note = "payload inflated from the boot image";
+		return 1;
+	}
+	const uint64_t *from = (const uint64_t *)(uintptr_t)src;
+	uint64_t *to = (uint64_t *)(uintptr_t)PAYLOAD_BASE;
+	for (uint64_t i = 0; i < size / 8; i++) {
+		to[i] = from[i];
+	}
+	mailbox_note = "payload copied from the boot image";
+	return 1;
+}
