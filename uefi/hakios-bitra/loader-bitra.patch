+/*
+ * Image AP: a no-op write to gpio36 at UEFI time reset the phone. Now (tlmm_test=1): the configuration of all 180 pins read (reads only) and the
+ * non-zero ones listed; then the same no-op write on a few other pins, each said first, gpio36 last: the ring says how far it got.
+ */
+static void
+tlmm_test(void)
+{
+	static const int pins[] = { 0, 50, 100, 150, 36 };
+	uint32_t shown = 0;
+
+	mmu_walk(0x0f100000ULL);
+	mmu_walk(0x9c000000ULL);
+	print("tlmm: scanning the CFG registers of gpio0..179 (reads only)\n");
+	for (int pin = 0; pin < 180; pin++) {
+		uint32_t c = *(volatile uint32_t *)(uintptr_t)(0x0f100000ULL + 0x1000ULL * (uint64_t)pin);
+
+		if (c != 0) {
+			print("tlmm: gpio%d CFG %x\n", (uint64_t)pin, (uint64_t)c);
+			shown++;
+		}
+	}
+	print("tlmm: %d of 180 pins have a non-zero CFG\n", (uint64_t)shown);
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		uint64_t base = 0x0f100000ULL + 0x1000ULL * (uint64_t)pins[i];
+		volatile uint32_t *cfg = (volatile uint32_t *)(uintptr_t)base, *io = (volatile uint32_t *)(uintptr_t)(base + 4);
+		uint32_t c = *cfg, v = *io;
+
+		print("tlmm: gpio%d: CFG %x IO %x; writing CFG back (the same value) now\n", (uint64_t)pins[i], (uint64_t)c, (uint64_t)v);
+		*cfg = c;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("tlmm: gpio%d: CFG written; writing IO back (the same value) now\n", (uint64_t)pins[i]);
+		*io = v;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("tlmm: gpio%d: IO written\n", (uint64_t)pins[i]);
+	}
+	print("tlmm: all done\n");
+}
