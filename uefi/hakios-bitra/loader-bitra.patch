+/*
+ * Image AR: even a no-op write to gpio0's CFG resets the phone from here (UEFI, boot services still up); reads are fine. Qualcomm phones give
+ * the OS the pin controller when the boot loader hands over (ExitBootServices and the callbacks of its drivers), which this loader never does.
+ * tlmm_test=2: exit boot services (nothing of UEFI is used after it: the ring only), then the same no-op writes (gpio0, then gpio36 CFG and IO),
+ * then PSCI SYSTEM_RESET. The UFS driver's callback runs too (what it does to the device is the point of the next look).
+ */
+static efi_handle g_image;
+extern int64_t psci_call(uint64_t function, uint64_t a1, uint64_t a2, uint64_t a3);
+
+static void
+tlmm_ebs_test(void)
+{
+	static uint8_t map[256 * 1024] __attribute__((aligned(16)));
+	uint64_t size = sizeof(map), key = 0, dsz = 0;
+	uint32_t dver = 0;
+	efi_status st;
+
+	print("ebs: getting the memory map\n");
+	st = BS->get_memory_map(&size, map, &key, &dsz, &dver);
+	print("ebs: map %d bytes, status %x; exiting boot services now (the screen is quiet from here)\n", size, (uint64_t)st);
+	screen_quiet = 1;
+	st = BS->exit_boot_services(g_image, key);
+	if (EFI_ERROR(st)) {
+		size = sizeof(map);
+		st = BS->get_memory_map(&size, map, &key, &dsz, &dver);
+		st = BS->exit_boot_services(g_image, key);
+	}
+	print("ebs: exit_boot_services status %x\n", (uint64_t)st);
+	if (EFI_ERROR(st)) {
+		return;
+	}
+	for (int i = 0; i < 2; i++) {
+		uint64_t pin = i == 0 ? 0 : 36, base = 0x0f100000ULL + 0x1000ULL * pin;
+		volatile uint32_t *cfg = (volatile uint32_t *)(uintptr_t)base, *io = (volatile uint32_t *)(uintptr_t)(base + 4);
+		uint32_t c = *cfg, v = *io;
+
+		print("ebs: gpio%d: CFG %x IO %x; writing CFG back now\n", pin, (uint64_t)c, (uint64_t)v);
+		*cfg = c;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("ebs: gpio%d: CFG written; writing IO back now\n", pin);
+		*io = v;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("ebs: gpio%d: IO written\n", pin);
+	}
+	print("ebs: the pin controller took the writes; PSCI SYSTEM_RESET now\n");
+	psci_call(0x84000009ULL, 0, 0, 0);
+}
+
+/*
+ * Image AU: the mapping is Device-nGnRnE, so the resets are not an attribute problem (image AT). tlmm_test=3: (1) Qualcomm's secure monitor register
+ * calls (SCM svc 5 IO_READ cmd 1 / IO_WRITE cmd 2, fast SMC64: 0xC2000501 / 0xC2000502, arginfo = number of value arguments) on gpio36's CFG: the read first
+ * (it must give the same value as the direct read), then the write of the same value; (2) direct no-op writes on other pins first (50, 100, 150),
+ * gpio0 and gpio36 last, each said before it is done.
+ */
+static void
+scm_smc(uint64_t fn, uint64_t argn, uint64_t a0, uint64_t a1, uint64_t *r)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = argn;
+	register uint64_t x2 __asm__("x2") = a0;
+	register uint64_t x3 __asm__("x3") = a1;
+	register uint64_t x4 __asm__("x4") = 0;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6)
+                : : "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	r[0] = x0; r[1] = x1; r[2] = x2; r[3] = x3;
+}
+
+static void
+tlmm_scm_test(void)
+{
+	static const int pins[] = { 50, 100, 150, 0, 36 };
+	uint64_t r[4], a = 0x0f100000ULL + 0x1000ULL * 36;
+	uint32_t direct = *(volatile uint32_t *)(uintptr_t)a;
+
+	print("scm: direct read of gpio36 CFG %x\n", (uint64_t)direct);
+	scm_smc(0xC2000501ULL, 1, a, 0, r);
+	print("scm: IO_READ: x0 %x x1 %x x2 %x x3 %x\n", r[0], r[1], r[2], r[3]);
+	print("scm: IO_WRITE of the same value now\n");
+	scm_smc(0xC2000502ULL, 2, a, direct, r);
+	print("scm: IO_WRITE: x0 %x x1 %x\n", r[0], r[1]);
+	scm_smc(0xC2000501ULL, 1, a, 0, r);
+	print("scm: IO_READ after: x0 %x x1 %x\n", r[0], r[1]);
+	for (unsigned i = 0; i < sizeof(pins) / sizeof(pins[0]); i++) {
+		uint64_t base = 0x0f100000ULL + 0x1000ULL * (uint64_t)pins[i];
+		volatile uint32_t *cfg = (volatile uint32_t *)(uintptr_t)base;
+		uint32_t c = *cfg;
+
+		print("tlmm: gpio%d: CFG %x; writing it back now\n", (uint64_t)pins[i], (uint64_t)c);
+		*cfg = c;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("tlmm: gpio%d: CFG written\n", (uint64_t)pins[i]);
+	}
+	print("tlmm: all writes passed\n");
+}
