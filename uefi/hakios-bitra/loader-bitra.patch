+
+				*(volatile uint32_t *)(uintptr_t)(SMMU_PA + 0xc00 + 4 * i) = ns2;
+				__asm__ volatile ("dsb sy" ::: "memory");
+				print("smmu: %d s2cr %x -> %x (bypass)\n", (uint64_t)i, (uint64_t)s2, (uint64_t)smmu_rd(0xc00 + 4 * i));
+			}
+		}
+	}
+	print("smmu: %d entries match the UFS stream IDs\n", (uint64_t)found);
+	if (found == 0 && smmu_bypass_requested) {
+		/*
+		 * None does (image S: sCR0 USFCFG=1, 5 valid groups; UEFI's driver maps the controller only around its own commands): a
+		 * transaction of an unmatched stream is a fault, and the secure side answers a fault with a hard reset. Plain bypass is
+		 * refused here (image T: the S2CR of a bypass group reads back as fault). So: a stage 1 context bank with an identity map
+		 * of the first 16 GB (one level 1 table of 1 GB blocks), and the groups of 0xe0 and 0x4e0 translate through it.
+		 */
+		static const uint32_t sids[2] = { 0xe0, 0x4e0 };
+		uint32_t idr1 = smmu_rd(0x24), pagesize = (idr1 >> 31) ? 0x10000 : 0x1000, numcb = idr1 & 0xff;
+		uint32_t numpage = 1u << (((idr1 >> 28) & 7) + 1), cb = 0xffffffffu, next = 4;
+		uint64_t gr1 = SMMU_PA + pagesize, cbbase = SMMU_PA + (uint64_t)(numpage / 2) * pagesize, ttpa = 0;
+		uint8_t used[128] = { 0 };
+
+		print("smmu: IDR1 %x: page size %x, %d pages, %d context banks, context banks at %x\n", (uint64_t)idr1,
+		    (uint64_t)pagesize, (uint64_t)numpage, (uint64_t)numcb, cbbase);
+		for (uint32_t i = 0; i < n && i < 128; i++) {
+			uint32_t v = smmu_rd(0xc00 + 4 * i);
+
+			if (((v >> 16) & 3) == 0 && (smmu_rd(0x800 + 4 * i) >> 31) && (v & 0xff) < 128) {
+				used[v & 0xff] = 1;
+			}
+		}
+		/*
+		 * Image Y: writing SCTLR (enabling a translated bank) hangs the bus here, and reading an enabled bank does too. Linux's Qualcomm
+		 * SMMU code answers the hypervisor's refusal of bypass (image T) by reserving the LAST context bank as a bypass bank:
+		 * CBAR type 1 (stage 1 with stage 2 bypass), translation off (SCTLR.M = 0), and bypass groups get S2CR type 0 (translate) with
+		 * that bank (here 73: groups 0 and 1 are that way in Linux). So: CBAR of the last bank, no SCTLR, no table, no read back.
+		 */
+		cb = numcb - 1;
+		print("smmu: bypass bank %d (the last): writing CBAR only\n", (uint64_t)cb);
+		*(volatile uint32_t *)(uintptr_t)(gr1 + 4 * cb) = 0x10000u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		print("smmu: bypass bank %d: CBAR written\n", (uint64_t)cb);
+		(void)used; (void)ttpa; (void)cbbase;
+		for (int k = 0; k < 2; k++) {
+			while (next < n && (smmu_rd(0x800 + 4 * next) >> 31) != 0) {
+				next++;
+			}
+			if (next >= n) {
+				print("smmu: no free stream group for %x\n", (uint64_t)sids[k]);
+				break;
+			}
+			print("smmu: group %d for stream %x -> bank %d now\n", (uint64_t)next, (uint64_t)sids[k], (uint64_t)cb);
+			*(volatile uint32_t *)(uintptr_t)(SMMU_PA + 0xc00 + 4 * next) = cb;         /* S2CR: translate, the bypass bank */
+			__asm__ volatile ("dsb sy" ::: "memory");
+			*(volatile uint32_t *)(uintptr_t)(SMMU_PA + 0x800 + 4 * next) = 0x80000000u | sids[k];
+			__asm__ volatile ("dsb sy" ::: "memory");
+			print("smmu: group %d: smr %x s2cr %x\n", (uint64_t)next, (uint64_t)smmu_rd(0x800 + 4 * next),
+			    (uint64_t)smmu_rd(0xc00 + 4 * next));
+			next++;
+		}
+		*(volatile uint32_t *)(uintptr_t)(SMMU_PA + 0x68) = 0;                          /* TLB invalidate all, then sync */
+		*(volatile uint32_t *)(uintptr_t)(SMMU_PA + 0x70) = 0;
+		for (int w = 0; w < 1000 && (smmu_rd(0x74) & 1); w++) {
+			BS->stall(100);
+		}
+		print("smmu: done; sGFSR %x\n", (uint64_t)smmu_rd(0x48));
+	}
+	lring_sync();
+}
