+static uint32_t
+inf_bits(struct inf_state *s, int need)
+{
+	uint32_t val = s->bitbuf;
+
+	while (s->bitcnt < (uint32_t)need) {
+		if (s->incnt >= s->inlen) {
+			s->err = 1;
+			return 0;
+		}
+		val |= (uint32_t)s->in[s->incnt++] << s->bitcnt;
+		s->bitcnt += 8;
+	}
+	s->bitbuf = val >> need;
+	s->bitcnt -= (uint32_t)need;
+	return val & ((1u << need) - 1);
+}
+
+static int
+inf_decode(struct inf_state *s, const struct inf_huff *h)
+{
+	int code = 0, first = 0, index = 0;
+
+	for (int len = 1; len <= 15; len++) {
+		code |= (int)inf_bits(s, 1);
+		if (s->err) {
+			return -1;
+		}
+		int count = h->count[len];
+
+		if (code - count < first) {
+			return h->symbol[index + (code - first)];
+		}
+		index += count;
+		first += count;
+		first <<= 1;
+		code <<= 1;
+	}
+	return -1;
+}
