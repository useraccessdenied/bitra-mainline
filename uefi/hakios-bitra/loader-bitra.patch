+static inline uint32_t
+smmu_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(uintptr_t)(SMMU_PA + off);
+}
+
+static void
+smmu_dump_bypass(void)
+{
+	uint32_t scr0, idr0, n, found = 0;
+
+	print("smmu: reading sCR0 at %x now\n", SMMU_PA);
+	scr0 = smmu_rd(0x0);
+	print("smmu: sCR0 read; reading IDR0\n");
+	idr0 = smmu_rd(0x20);
+	n = idr0 & 0xff;
+
+	print("smmu: sCR0 %x IDR0 %x (%d stream groups) sGFSR %x sGFSYNR0 %x\n", (uint64_t)scr0, (uint64_t)idr0, (uint64_t)n,
+	    (uint64_t)smmu_rd(0x48), (uint64_t)smmu_rd(0x50));
+	if (n > 128) {
+		n = 128;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i), s2 = smmu_rd(0xc00 + 4 * i);
+		uint32_t id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		int ufs = 0;
+
+		for (int k = 0; k < 2; k++) {
+			uint32_t sid = k ? 0x4e0 : 0xe0;
+
+			if ((smr >> 31) && (((sid ^ id) & ~mask & 0x7fff) == 0)) {
+				ufs = 1;
+			}
+		}
