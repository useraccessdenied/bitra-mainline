+		return 0;
+	}
+	for (int len = 1; len < 16; len++) {
+		left <<= 1;
+		left -= h->count[len];
+		if (left < 0) {
+			return left;
+		}
+	}
+	offs[1] = 0;
+	for (int len = 1; len < 15; len++) {
+		offs[len + 1] = (uint16_t)(offs[len] + h->count[len]);
+	}
+	for (int sym = 0; sym < n; sym++) {
+		if (length[sym] != 0) {
+			h->symbol[offs[length[sym]]++] = (uint16_t)sym;
+		}
+	}
+	return left;
+}
