+/*
+ * bitra: can the pin controller (TLMM, 0x0f100000) be written from here, at UEFI time? Image AN/AO: writes of gpio39's and gpio36's registers
+ * from the kernel reset the phone while reads are fine. A harmless test: write what a pin already has back to it (a logical no-op), the
+ * steps said first to the ring (tlmm_test=PIN on the command line).
+ */
+static int tlmm_test_pin = -1;
+static int touch_pins_requested;
+
+/*
+ * Image AT: how is 0x0f100000 mapped (UEFI's tables, TTBR0_EL1)? A write through a Normal-cacheable mapping of a device region can end in an external
+ * abort that resets the phone while reads work. Prints TTBR0/TCR/MAIR/SCTLR and every level of the walk for the TLMM and, as a comparison, for the
+ * framebuffer. Reads of page-table memory only.
+ */
+static void
+mmu_walk(uint64_t va)
+{
+	uint64_t ttbr, tcr, mair, sctlr, tg, t0sz, lvl_start, tbl;
+	unsigned granule_shift;
+
+	__asm__ volatile ("mrs %0, ttbr0_el1" : "=r"(ttbr));
+	__asm__ volatile ("mrs %0, tcr_el1" : "=r"(tcr));
+	__asm__ volatile ("mrs %0, mair_el1" : "=r"(mair));
+	__asm__ volatile ("mrs %0, sctlr_el1" : "=r"(sctlr));
+	print("mmu: va %x: TTBR0 %x TCR %x MAIR %x SCTLR %x\n", va, ttbr, tcr, mair, sctlr);
+	tg = (tcr >> 14) & 3;
+	t0sz = tcr & 63;
+	granule_shift = tg == 0 ? 12 : tg == 2 ? 14 : 16;
+	if (granule_shift != 12) {
+		print("mmu: granule %d, walk not done\n", (uint64_t)granule_shift);
+		return;
+	}
+	/* 4 KB granule: 48 bit VA starts at level 0, 39 bit at level 1 */
+	lvl_start = (64 - t0sz) > 39 ? 0 : 1;
+	tbl = ttbr & 0x0000fffffffff000ULL;
+	for (uint64_t lvl = lvl_start; lvl < 4; lvl++) {
+		unsigned shift = 12 + 9 * (3 - (unsigned)lvl);
+		uint64_t idx = (va >> shift) & 511, d = ((volatile uint64_t *)(uintptr_t)tbl)[idx];
+
+		print("mmu:   L%d [%d] = %x\n", lvl, idx, d);
+		if ((d & 3) == 0) {
+			print("mmu:   not mapped\n");
+			return;
+		}
+		if (lvl == 3 || (d & 3) == 1) {
+			uint64_t ai = (d >> 2) & 7;
+
+			print("mmu:   leaf: AttrIndx %d = MAIR byte %x, SH %d, AP %d, XN %d\n", ai, (mair >> (8 * ai)) & 0xff, (d >> 8) & 3, (d >> 6) & 3, (d >> 53) & 1);
+			return;
+		}
+		tbl = d & 0x0000fffffffff000ULL;
+	}
+}
