+	BS->locate_protocol(&i2c_guid, NULL, (void **)&ic);
+	print("tp: protocols TLMM %x VREG %x I2C %x\n", (uint64_t)(uintptr_t)tl, (uint64_t)(uintptr_t)vr, (uint64_t)(uintptr_t)ic);
+	if (!tl || !vr || !ic) {
+		return;
+	}
+	{
+		uint64_t daif;
+
+		__asm__ volatile ("mrs %0, daif" : "=r"(daif));
+		print("tp: DAIF %x (bit 7 I = IRQ masked, bit 6 F = FIQ masked)\n", daif);
+	}
+	print("tp: ConfigGpio gpio39 input pull-up\n");
+	st = tl->config_gpio(irq, 1);
+	print("tp: status %x\n", (uint64_t)st);
+	delay_us(20000);
+	print("tp: reset low\n");
+	tl->config_gpio(rst, 1);
+	tl->gpio_out(rst, 0);
+	delay_us(20000);
+	print("tp: reset high\n");
+	tl->gpio_out(rst, 1);
+	for (int ms = 0; ms < 600; ms += 100) {
+		v = 9;
+		tl->gpio_in(irq, &v);
+		print("tp: +%d ms: gpio39 %d\n", (uint64_t)ms, (uint64_t)v);
+		delay_us(100000);
+	}
+	for (unsigned b = 0; b < sizeof(buses) / sizeof(buses[0]); b++) {
+		void *h = NULL;
+		qc_i2c_slave cfg = { 400, 0x4b, 0, 0, 0, 0 };
+		uint8_t buf[4] = { 0, 0, 0, 0 };
+		uint32_t got = 0, rc;
+
+		rc = ic->open(buses[b], &h);
+		print("tp: i2c %d: open %x\n", (uint64_t)buses[b], (uint64_t)rc);
+		if (rc != 0 || !h) {
+			continue;
+		}
+		for (int k = 0; k < 3; k++) {
+			got = 0;
+			rc = ic->read(h, &cfg, 0, 0, buf, 4, &got, 50);
+			v = 9;
+			tl->gpio_in(irq, &v);
+			print("tp: i2c %d: read 4 bytes: status %x got %d: %x %x %x %x (gpio39 %d)\n", (uint64_t)buses[b], (uint64_t)rc, (uint64_t)got,
+			    (uint64_t)buf[0], (uint64_t)buf[1], (uint64_t)buf[2], (uint64_t)buf[3], (uint64_t)v);
+			if (rc == 0) {
+				break;
+			}
+			delay_us(100000);
+		}
+		ic->close(h);
+	}
+	{
+		void *h = NULL;
+		qc_i2c_slave cfg = { 400, 0, 0, 0, 0, 0 };
+		uint8_t b1;
+		uint32_t got, rc;
+
+		if (ic->open(12, &h) == 0 && h) {
+			print("tp: scanning 0x08..0x77 on bus 12\n");
+			for (uint32_t a = 8; a < 0x78; a++) {
+				cfg.slave_address = a;
+				got = 0;
+				rc = ic->read(h, &cfg, 0, 0, &b1, 1, &got, 20);
+				if (rc == 0) {
+					print("tp: scan: 0x%x answers (byte %x)\n", (uint64_t)a, (uint64_t)b1);
+				}
+			}
+			ic->close(h);
+			print("tp: scan done\n");
+		}
+	}
+	print("tp: enabling l11c (dev2 LDO11) now (this may hang)\n");
+	st = vr->vreg_control(2, 10, 1);
+	print("tp: l11c status %x\n", (uint64_t)st);
+	print("tp: done\n");
+}
