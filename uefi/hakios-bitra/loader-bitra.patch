+		efi_guid **g;
+		uint64_t n = 0;
+
+		if (EFI_ERROR(BS->protocols_per_handle(handles[i], &g, &n))) {
+			continue;
+		}
+		for (uint64_t j = 0; j < n; j++) {
+			void *iface = NULL;
+
+			BS->handle_protocol(handles[i], g[j], &iface);
+			const uint32_t *w = (const uint32_t *)g[j];
+
+			print("proto: h%d w %x %x %x %x if %x\n", i, (uint64_t)w[0], (uint64_t)w[1], (uint64_t)w[2], (uint64_t)w[3],
