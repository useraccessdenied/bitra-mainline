+	static const efi_guid i2c_guid = { 0xb27ae8b1, 0x3e10, 0x4d07, { 0xab, 0x5c, 0xeb, 0x9a, 0x6d, 0xc6, 0xfa, 0x8f } };
+	static const uint32_t buses[] = { 12, 2, 6, 16, 17 };
+	qc_tlmm *tl = NULL;
+	qc_vreg *vr = NULL;
+	qc_i2c *ic = NULL;
+	efi_status st;
+	uint32_t rst = (38u << 4) | (1u << 14) | 0x20000000u, irq = (39u << 4) | (3u << 15) | 0x20000000u, v;
