+/* inflate a gzip stream (RFC 1952, one member); returns the output size, or 0 with *why set */
+static uint64_t
+gunzip(const uint8_t *in, uint64_t inlen, uint8_t *out, uint64_t outlen, const char **why)
+{
+	struct inf_state s = {.in = in, .inlen = inlen, .out = out, .outlen = outlen};
+	uint64_t pos = 10;
+	int last, r;
+
+	if (inlen < 18 || in[0] != 0x1f || in[1] != 0x8b || in[2] != 8) {
+		*why = "not a gzip stream";
+		return 0;
+	}
+	if (in[3] & 4) {
+		pos += 2 + (in[pos] | (uint64_t)in[pos + 1] << 8);
+	}
+	if (in[3] & 8) {
+		while (pos < inlen && in[pos++] != 0) {
+		}
+	}
+	if (in[3] & 16) {
+		while (pos < inlen && in[pos++] != 0) {
+		}
+	}
+	if (in[3] & 2) {
+		pos += 2;
+	}
+	if (pos >= inlen) {
+		*why = "gzip header is cut off";
+		return 0;
+	}
+	s.incnt = pos;
+	do {
+		last = (int)inf_bits(&s, 1);
+		r = inf_block(&s, (int)inf_bits(&s, 2));
+		if (r != 0 || s.err) {
+			*why = "the payload does not inflate";
+			return 0;
+		}
+	} while (!last);
+	/* trailer: CRC-32 and size of the output, after the deflate stream (which ends on a byte boundary) */
+	if (s.incnt + 8 > inlen) {
+		*why = "gzip trailer is cut off";
+		return 0;
+	}
+	const uint8_t *t = in + s.incnt;
+	uint32_t crc_want = t[0] | (uint32_t)t[1] << 8 | (uint32_t)t[2] << 16 | (uint32_t)t[3] << 24;
+	uint32_t size_want = t[4] | (uint32_t)t[5] << 8 | (uint32_t)t[6] << 16 | (uint32_t)t[7] << 24;
+	static const uint32_t nib[16] = {0x00000000, 0x1db71064, 0x3b6e20c8, 0x26d930ac, 0x76dc4190, 0x6b6b51f4, 0x4db26158,
+	    0x5005713c, 0xedb88320, 0xf00f9344, 0xd6d6a3e8, 0xcb61b38c, 0x9b64c2b0, 0x86d3d2d4, 0xa00ae278, 0xbdbdf21c};
+	uint32_t crc = 0xffffffffu;
+
+	for (uint64_t i = 0; i < s.outcnt; i++) {
+		crc ^= out[i];
+		crc = (crc >> 4) ^ nib[crc & 15];
+		crc = (crc >> 4) ^ nib[crc & 15];
+	}
+	crc = ~crc;
+	if (s.outcnt != size_want || crc != crc_want) {
+		*why = "the inflated payload fails its CRC or size check";
+		return 0;
+	}
+	return s.outcnt;
+}
