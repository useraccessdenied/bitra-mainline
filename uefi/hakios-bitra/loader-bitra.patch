+typedef struct {
+	uint64_t revision;
+	efi_status (EFIAPI *config_gpio)(uint32_t config, uint32_t enable);
+	efi_status (EFIAPI *config_gpio_group)(uint32_t enable, uint32_t *group, uint32_t size);
