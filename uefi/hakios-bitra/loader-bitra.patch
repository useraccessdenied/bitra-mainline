+/*
+ * bitra: this loader's own log in RAM (a second post-mortem ring, 0xf0800000, "XNULDLOG", u32 bytes at +8, text from +64), so that
+ * a hard reset during a hardware experiment does not lose what was printed. Written out (and cleaned from the caches) by
+ * lring_sync() before each risky step. Read from Linux with tools/xnulog (pa=0xf0100000).
+ */
+static void
+lring_init(void)
+{
+	uint64_t a = 0xf0800000ULL;                 /* after the kernel's 8 MiB ring (f0000000) */
+
+	if (!EFI_ERROR(BS->allocate_pages(AllocateAddress, EfiLoaderData, 1024, &a))) {
+		lring = (uint8_t *)(uintptr_t)a;
+		memset(lring, 0, 64);
+		memcpy(lring, "XNULDLOG", 8);
+		clean_dcache((uint64_t)(uintptr_t)lring, (uint64_t)(uintptr_t)lring + 64);
+	}
+}
+
+static void
+lring_sync(void)
+{
+	uint32_t n = (uint32_t)log_len;
+
+	if (lring == NULL) {
+		return;
+	}
+	if (n > (4u << 20) - 64) {
+		n = (4u << 20) - 64;
+	}
+	memcpy(lring + 64, log_buf, n);
+	*(volatile uint32_t *)(lring + 8) = n;
+	clean_dcache((uint64_t)(uintptr_t)lring, (uint64_t)(uintptr_t)lring + 64 + n);
