+/* bitra: Mu keeps its debug log in RAM ("Log Buffer" at 0x9FFF7000, 32 KiB). Show the lines that mention the UFS driver
+ * (and the first bytes, to see what the buffer is), to learn why UFSDxe gives no block devices. */
+static void
+show_firmware_log(void)
+{
+	const volatile uint8_t *b = (const volatile uint8_t *)(uintptr_t)0x9FFF7000ULL;
+	uint64_t shown = 0, start = 0;
+
+	print("fwlog: ");
+	for (uint64_t i = 0; i < 24; i++) {
+		print("%x ", (uint64_t)b[i]);
+	}
+	print("\n");
+	for (uint64_t i = 0; i <= 0x8000 && shown < 24; i++) {
+		uint8_t c = i < 0x8000 ? b[i] : '\n';
+
+		if (c != '\n' && c != 0) {
+			continue;
+		}
+		uint64_t n = i - start;
+		int hit = 0;
+
+		for (uint64_t j = 0; j + 3 <= n && !hit; j++) {
+			uint8_t x = b[start + j] | 0x20, y = b[start + j + 1] | 0x20, z = b[start + j + 2] | 0x20;
+
+			hit = x == 'u' && y == 'f' && z == 's';
+		}
+		if (hit) {
+			char line[96];
+			uint64_t k = 0;
+
+			for (; k < n && k < sizeof(line) - 1; k++) {
+				uint8_t ch = b[start + k];
+
+				line[k] = ch >= 32 && ch < 127 ? (char)ch : '.';
+			}
+			line[k] = 0;
+			print("fwlog: %s\n", line);
+			shown++;
+		}
+		start = i + 1;
+	}
+	print("fwlog: %d UFS lines\n", shown);
+}
