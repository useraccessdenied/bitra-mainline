+			print("pt: i2c instance %d: open now\n", (uint64_t)order[i]);
+			rc = ic->open(order[i], &h);
+			print("pt: i2c instance %d: open %x handle %x\n", (uint64_t)order[i], (uint64_t)rc, (uint64_t)(uintptr_t)h);
+			if (rc != 0 || !h) {
+				continue;
+			}
+			rc = ic->read(h, &cfg, 0, 0, &b, 1, &got, 20);
+			print("pt: i2c instance %d: read 0x4b: status %x got %d byte %x\n", (uint64_t)order[i], (uint64_t)rc, (uint64_t)got, (uint64_t)b);
+			ic->close(h);
+		}
+	}
+	print("pt: done\n");
+}
