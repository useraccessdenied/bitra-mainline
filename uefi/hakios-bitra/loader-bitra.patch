+	efi_status (EFIAPI *gpio_out)(uint32_t config, uint32_t value);
+	efi_status (EFIAPI *set_inactive)(uint32_t gpio, uint32_t config);
+} qc_tlmm;
+
+typedef struct {
+	uint64_t revision;
+	efi_status (EFIAPI *vreg_control)(uint32_t dev, uint32_t id, uint8_t enable);
