+/*
+ * bitra: UEFI only connects the drivers of its boot devices, so Qualcomm's UFS driver (UFSDxe) may be loaded and still
+ * have no BlockIo. ConnectController(recursive) on every handle brings its block devices and the partition driver's
+ * children (the partitions, with PartitionInfo) into being. Harmless where they already exist.
+ */
+static void
+connect_all_controllers(void)
+{
+	efi_handle *handles;
+	uint64_t count, connected = 0;
+	typedef efi_status (EFIAPI *connect_fn)(efi_handle, efi_handle *, void *, uint8_t);
+
+	if (EFI_ERROR(BS->locate_handle_buffer(AllHandles, NULL, NULL, &count, &handles))) {
+		print("ufs: connect: no handle list\n");
+		return;
+	}
+	for (uint64_t i = 0; i < count; i++) {
+		if (!EFI_ERROR(((connect_fn)BS->connect_controller)(handles[i], NULL, NULL, 1))) {
+			connected++;
+		}
+	}
+	BS->free_pool(handles);
+	print("ufs: connect: %d handles, %d connected\n", count, connected);
+}
