+/*
+ * Image AZ (touch_pins=1): the pins of the touch screen set through Mu's TLMM protocol (raw writes reset the phone): gpio36 (SDA) and gpio37 (SCL) to the
+ * serial engine's function 1 ("qup13") with the pull-up and 2 mA drive, gpio38 (the chip's reset) an output driven high (not in reset), gpio39 (its
+ * interrupt line) an input with a pull-up. The pin state stays when the kernel takes over; the kernel's touch driver then powers the chip (RPMh)
+ * and talks to it through the serial engine.
+ */
+static void
+touch_pins_setup(void)
+{
+	static const efi_guid tlmm_guid = { 0xad9aec18, 0x7bf0, 0x4809, { 0x9e, 0x96, 0x30, 0x12, 0x30, 0x9f, 0x3d, 0xf7 } };
+	qc_tlmm *tl = NULL;
+	efi_status st;
+	uint32_t sda = (36u << 4) | 1u | (0u << 14) | (3u << 15) | (0u << 17) | 0x20000000u;
+	uint32_t scl = (37u << 4) | 1u | (0u << 14) | (3u << 15) | (0u << 17) | 0x20000000u;
+	uint32_t rst = (38u << 4) | (1u << 14) | 0x20000000u;
+	uint32_t irq = (39u << 4) | (3u << 15) | 0x20000000u;
+
+	st = BS->locate_protocol(&tlmm_guid, NULL, (void **)&tl);
+	print("touch pins: TLMM protocol status %x at %x\n", (uint64_t)st, (uint64_t)(uintptr_t)tl);
+	if (!tl) {
+		return;
+	}
+	st = tl->config_gpio(sda, 1);
+	print("touch pins: gpio36 (SDA) qup13: %x\n", (uint64_t)st);
+	st = tl->config_gpio(scl, 1);
+	print("touch pins: gpio37 (SCL) qup13: %x\n", (uint64_t)st);
+	st = tl->config_gpio(irq, 1);
+	print("touch pins: gpio39 (interrupt) input pull-up: %x\n", (uint64_t)st);
+	st = tl->config_gpio(rst, 1);
+	st |= tl->gpio_out(rst, 1);
+	print("touch pins: gpio38 (reset) output high: %x\n", (uint64_t)st);
+}
