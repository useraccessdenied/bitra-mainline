+	print("fwlog: ");
+	for (uint64_t i = 0; i < 24; i++) {
+		print("%x ", (uint64_t)b[i]);
+	}
+	print("\n");
+	for (uint64_t i = 0; i <= 0x8000 && shown < 24; i++) {
+		uint8_t c = i < 0x8000 ? b[i] : '\n';
+
+		if (c != '\n' && c != 0) {
+			continue;
+		}
+		uint64_t n = i - start;
+		int hit = 0;
+
+		for (uint64_t j = 0; j + 3 <= n && !hit; j++) {
+			uint8_t x = b[start + j] | 0x20, y = b[start + j + 1] | 0x20, z = b[start + j + 2] | 0x20;
