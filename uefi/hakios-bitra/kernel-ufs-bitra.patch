+/*
+ * ufs_native=4 (bitra experiment): a TEST UNIT READY through UEFI's own list, to find out which memory the controller's DMA may
+ * reach. 1: UEFI's descriptor memory (the UCD where UEFI keeps it, no switch); 2: only the UCD moved to this kernel's area
+ * (the loader's pages), the list still UEFI's. Each step is said before the doorbell: the post-mortem log keeps the last line
+ * if the phone resets. UEFI's slot 0 and its UCD are put back afterwards.
+ */
+static void
+hc_uefi_tur_once(const char *tag, uint64_t ucd_pa, volatile uint8_t *ucd)
+{
+	volatile uint32_t *l = hc_uefi_list;
+	uint64_t t;
+	uint32_t db;
+
+	for (int i = 0; i < 0x80; i++) {
+		ucd[i] = 0;
+	}
+	ucd[0] = 0x01;                          /* COMMAND UPIU, SCSI, LUN 0, tag 0, TEST UNIT READY (CDB 00) */
+	l[0] = 0x01000000;                      /* as UEFI's: command type 0, interrupt, no data */
+	l[1] = 0;
+	l[2] = 0x0f;
+	l[3] = 0;
+	l[4] = (uint32_t)ucd_pa;
+	l[5] = (uint32_t)(ucd_pa >> 32);
+	l[6] = 0x00080010;                      /* as UEFI's: response 8 dwords at dword 16 */
+	l[7] = 0x00180000;                      /* no PRDT */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	hc_say("ufs: native: uefi-tur %s: ringing UEFI's slot 0 with the UCD at %llx now (list %08x:%08x run %u IS %08x)\n", tag,
+	    (unsigned long long)ucd_pa, hc_read(UFSHC_UTRLBAU), hc_read(UFSHC_UTRLBA), hc_read(UFSHC_UTRLRSR) & 1,
+	    hc_read(UFSHC_IS));
+	hc_write(UFSHC_UTRLDBR, 1);
+	for (t = mach_absolute_time(); (hc_read(UFSHC_UTRLDBR) & 1) && hc_us_since(t) < 300000;) {
+		__builtin_arm_yield();
+	}
+	db = hc_read(UFSHC_UTRLDBR);
+	hc_say("ufs: native: uefi-tur %s: doorbell %08x IS %08x OCS %02x response %02x %02x %02x %02x status %02x\n", tag, db,
+	    hc_read(UFSHC_IS), l[2] & 0xff, ucd[0x40], ucd[0x41], ucd[0x42], ucd[0x43], ucd[0x47]);
+	hc_write(UFSHC_UTRLCNR, 1);             /* the completion notification, as UEFI's driver clears it */
+	hc_write(UFSHC_IS, hc_read(UFSHC_IS) & 1);
+}
