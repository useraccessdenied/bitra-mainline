+void
+ufshc_debug_slot(uint32_t n)
+{
+	struct hc_slot *s = &hc_slots[n];
+	volatile const uint32_t *u = (volatile const uint32_t *)s->ucd;
+	volatile const uint32_t *prd = u + UCD_PRDT / 4;
+	const uint8_t *d = (const uint8_t *)s->data;
+	uint32_t nz = 0, first = 0xffffffffu;
