+	hc_say("ufs: native: slot %u: UTRD %08x %08x %08x %08x %08x %08x %08x %08x; data %llx (kernel %p)\n", n, s->utrd[0], s->utrd[1],
+	    s->utrd[2], s->utrd[3], s->utrd[4], s->utrd[5], s->utrd[6], s->utrd[7], (unsigned long long)s->data_pa, (const void *)s->data);
+	hc_say("ufs: native: slot %u: command UPIU %08x %08x %08x %08x %08x %08x %08x %08x\n", n, u[0], u[1], u[2], u[3], u[4], u[5], u[6],
+	    u[7]);
+	hc_say("ufs: native: slot %u: response UPIU %08x %08x %08x %08x %08x %08x %08x %08x\n", n, u[UCD_RESPONSE / 4], u[UCD_RESPONSE / 4 + 1],
+	    u[UCD_RESPONSE / 4 + 2], u[UCD_RESPONSE / 4 + 3], u[UCD_RESPONSE / 4 + 4], u[UCD_RESPONSE / 4 + 5], u[UCD_RESPONSE / 4 + 6],
+	    u[UCD_RESPONSE / 4 + 7]);
+	hc_say("ufs: native: slot %u: PRD %08x %08x %08x %08x\n", n, prd[0], prd[1], prd[2], prd[3]);
