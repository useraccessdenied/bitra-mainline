+void
+ufshc_uefi_tur_test(void)
+{
+	volatile uint32_t *l = hc_uefi_list;
+	uint32_t save[8];
+	uint64_t ucd = (uint64_t)l[5] << 32 | l[4];
+	volatile uint8_t *u;
+	uint8_t saved_ucd[0x80];
+	vm_offset_t area;
+	uint64_t apa = hc_loader.area_pa + hc_loader.ucd_offset;
+
+	if (l == NULL || ucd < hc_uefi_map_pa || ucd + 0x80 > hc_uefi_map_pa + hc_uefi_map_size) {
+		hc_say("ufs: native: uefi-tur: UEFI's descriptor is not in the page that is mapped\n");
+		return;
+	}
+	u = (volatile uint8_t *)(hc_uefi_map_va + (ucd - hc_uefi_map_pa));
+	for (int i = 0; i < 8; i++) {
+		save[i] = l[i];
+	}
+	for (int i = 0; i < 0x80; i++) {
+		saved_ucd[i] = u[i];
+	}
+	hc_uefi_tur_once("1 (UEFI's own UCD)", ucd, u);
+	area = ml_io_map_unmappable((vm_offset_t)(apa & ~(uint64_t)PAGE_MASK), PAGE_SIZE, VM_WIMG_WCOMB) +
+	    (vm_offset_t)(apa & PAGE_MASK);
