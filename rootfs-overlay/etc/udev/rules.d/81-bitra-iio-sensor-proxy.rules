# realme GT Neo 2: the sensors sit behind the SLPI (Qualcomm Sensor Core via libssc, docs/32). The stock iio-sensor-proxy rule only enables
# ssc-light and ssc-compass on the SDSP; add the accelerometer (auto-rotate) and the proximity sensor.
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel ssc-proximity"

# Accelerometer mount matrix (docs/32). Raw SSC readings: flat screen-up (0.4, 0.0, -9.8), portrait upright (-0.5, -9.8, -0.8), landscape with the top to
# the left (9.8, 0.0, -1.0). Z is inverted (flat must read face-up); the first guess diag(1,-1,-1) gave a UI rotated 180 degrees in portrait and landscape on
# the phone, so X and Y are flipped relative to that: diag(-1, 1, -1).
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{ACCEL_MOUNT_MATRIX}="-1, 0, 0; 0, 1, 0; 0, 0, -1"
