From cae53d2a60c454d4bc61b8f17e99a970c9512349 Mon Sep 17 00:00:00 2001
From: useraccessdenied <useraccessdenied@users.noreply.github.com>
Date: Sat, 21 Nov 2026 01:41:01 +0530
Subject: [PATCH 3/8] panel: add Samsung AMS662ZS01 (realme GT Neo 2) DSC
 cmd-mode driver; enable display pipeline and PON reboot modes in the bitra
 DTS

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8250-realme-bitra.dts     |  21 +-
 drivers/gpu/drm/panel/Kconfig                 |  10 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-samsung-ams662zs01.c  | 384 ++++++++++++++++++
 4 files changed, 412 insertions(+), 4 deletions(-)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-ams662zs01.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 09eff2c73..0b42bfb0a 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -44,13 +44,10 @@ &framebuffer {
 	stride = <(1080 * 4)>;
 };
 
-/* Stage 1: never touch storage, display pipeline, GPU, PCIe or remoteprocs */
+/* Never touch storage, GPU, DP, PCIe or remoteprocs until verified; the display pipeline is enabled for the panel bring-up */
 &ufs_mem_hc { status = "disabled"; };
 &ufs_mem_phy { status = "disabled"; };
-&mdss { status = "disabled"; };
 &mdss_dp { status = "disabled"; };
-&mdss_dsi0 { status = "disabled"; };
-&mdss_dsi0_phy { status = "disabled"; };
 &gpu { status = "disabled"; };
 &gmu { status = "disabled"; };
 &pcie0 { status = "disabled"; };
@@ -76,3 +73,19 @@ &usb_1_qmpphy {
 &ramoops {
 	reg = <0x0 0xb0000000 0x0 0x3ff000>;
 };
+
+/* Samsung AMS662ZS01 DSC command-mode panel; wiring from the stock tree (supplies differ from the OnePlus 8T) */
+&display_panel {
+	compatible = "samsung,ams662zs01";
+	vdd-supply = <&vreg_l13a_ts_3p0>;	/* VCI 3.0 V (pm8150_l13) */
+	vddr-supply = <&vreg_l2c_1p2>;		/* vendor "vout" rail (pm8150 C ldo2, 1.2 V) */
+	width-mm = <70>;
+	height-mm = <153>;
+	status = "okay";
+};
+
+/* reboot reasons through the PMIC PON, so `reboot bootloader` lands in ABL fastboot */
+&pon {
+	mode-bootloader = <0x2>;
+	mode-recovery = <0x1>;
+};
