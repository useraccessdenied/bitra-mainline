diff --git a/arch/arm64/kernel/bitra-dtb-blob.S b/arch/arm64/kernel/bitra-dtb-blob.S
new file mode 100644
index 000000000..516272269
--- /dev/null
+++ b/arch/arm64/kernel/bitra-dtb-blob.S
@@ -0,0 +1,8 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+	.section .rodata, "a"
+	.balign 8
+	.globl bitra_dtb_start
+bitra_dtb_start:
+	.incbin "arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dtb"
+	.globl bitra_dtb_end
+bitra_dtb_end:
diff --git a/arch/arm64/kernel/bitra-dtb-shim.c b/arch/arm64/kernel/bitra-dtb-shim.c
new file mode 100644
index 000000000..acbf615fd
--- /dev/null
+++ b/arch/arm64/kernel/bitra-dtb-shim.c
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * realme GT Neo 2 (bitra) bring-up shim.
+ *
+ * The OPLUS ABL only accepts an appended DTB that it can merge the vendor dtbo
+ * overlay into (matching msm-id/board-id/oplus,dtsi_no, plus the downstream
+ * __symbols__ the overlay references). A mainline tree cannot satisfy that, so
+ * the boot image carries the stock merged tree for ABL and the kernel swaps in
+ * the embedded mainline tree here, keeping only what ABL computed at runtime
+ * (/chosen: bootargs, initrd range, rng/kaslr seeds).
+ *
+ * Bring-up only. It goes away once a U-Boot stage hands Linux a proper DTB.
+ */
+#include <linux/init.h>
+#include <linux/libfdt.h>
+#include <linux/string.h>
+#include <linux/sizes.h>
+#include <linux/printk.h>
+#include <linux/sysfb.h>
+#include <linux/screen_info.h>
+#include <linux/io.h>
+#include <linux/sizes.h>
+
+#define BITRA_FB_BASE	0x9c000000UL
+#define BITRA_FB_W	1080
+#define BITRA_FB_H	2400
+
+/* Paint the top rows of ABL's panel buffer so we can see the kernel was entered. */
+static void __init bitra_fb_beacon(u32 argb)
+{
+	u32 *p;
+	int row, rows = 40;
+	size_t chunk = BITRA_FB_W * 4 * rows;
+
+	p = early_memremap(BITRA_FB_BASE, chunk);
+	if (!p)
+		return;
+	for (row = 0; row < BITRA_FB_W * rows; row++)
+		p[row] = argb;
+	early_memunmap(p, chunk);
+}
+
+extern const u8 bitra_dtb_start[], bitra_dtb_end[];
+
+static u8 bitra_dtb_buf[SZ_512K] __aligned(8);
+
+void *__init bitra_dtb_shim(void *abl_fdt)
+{
+	static const char *const props[] = {
+		"bootargs", "linux,initrd-start", "linux,initrd-end",
+		"rng-seed", "kaslr-seed",
+	};
+	int src, dst, i, len;
+	const void *val;
+
+	bitra_fb_beacon(0xff00ff00);	/* green: kernel entered */
+
+	/* describe ABL's panel buffer to the EFI-framebuffer earlycon (earlycon=efifb) */
+	sysfb_primary_display.screen = (struct screen_info) {
+		.orig_video_isVGA = VIDEO_TYPE_EFI,
+		.lfb_base = BITRA_FB_BASE,
+		.lfb_width = BITRA_FB_W,
+		.lfb_height = BITRA_FB_H,
+		.lfb_depth = 32,
+		.lfb_linelength = BITRA_FB_W * 4,
+		.lfb_size = BITRA_FB_W * 4 * BITRA_FB_H,
+		.red_size = 8, .red_pos = 16, .green_size = 8, .green_pos = 8,
+		.blue_size = 8, .blue_pos = 0,
+	};
+
+	if (fdt_check_header(bitra_dtb_start) ||
+	    fdt_totalsize(bitra_dtb_start) > sizeof(bitra_dtb_buf))
+		return abl_fdt;
+
+	memcpy(bitra_dtb_buf, bitra_dtb_start, fdt_totalsize(bitra_dtb_start));
+	if (fdt_open_into(bitra_dtb_buf, bitra_dtb_buf, sizeof(bitra_dtb_buf)))
+		return abl_fdt;
+
+	src = fdt_path_offset(abl_fdt, "/chosen");
+	dst = fdt_path_offset(bitra_dtb_buf, "/chosen");
+	if (src < 0 || dst < 0)
+		return abl_fdt;
+
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		val = fdt_getprop(abl_fdt, src, props[i], &len);
+		if (val)
+			fdt_setprop(bitra_dtb_buf, dst, props[i], val, len);
+	}
+	return bitra_dtb_buf;
+}
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 23c05dc7a..c88707f49 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -167,6 +167,10 @@ static void __init smp_build_mpidr_hash(void)
 		pr_warn("Large number of MPIDR hash buckets detected\n");
 }
 
+#ifdef CONFIG_BITRA_DTB_SHIM
+void *__init bitra_dtb_shim(void *abl_fdt);
+#endif
+
 static void __init setup_machine_fdt(phys_addr_t dt_phys)
 {
 	int size = 0;
@@ -176,6 +180,11 @@ static void __init setup_machine_fdt(phys_addr_t dt_phys)
 	if (dt_virt)
 		memblock_reserve(dt_phys, size);
 
+#ifdef CONFIG_BITRA_DTB_SHIM
+	if (dt_virt)
+		dt_virt = bitra_dtb_shim(dt_virt);
+#endif
+
 	/*
 	 * dt_virt is a fixmap address, hence __pa(dt_virt) can't be used.
 	 * Pass dt_phys directly.
diff --git a/drivers/firmware/efi/earlycon.c b/drivers/firmware/efi/earlycon.c
index 3d060d599..7bc261d7b 100644
--- a/drivers/firmware/efi/earlycon.c
+++ b/drivers/firmware/efi/earlycon.c
@@ -37,6 +37,9 @@ static int __init efi_earlycon_remap_fb(void)
 	/* bail if there is no bootconsole or it was unregistered already */
 	if (!earlycon_console || !console_is_registered(earlycon_console))
 		return 0;
+#ifdef CONFIG_BITRA_DTB_SHIM
+	/* bring-up: the mapping is kept for the permanent console below */
+#endif
 
 	efi_fb = memremap(fb_base, si->lfb_size, fb_wb ? MEMREMAP_WB : MEMREMAP_WC);
 
@@ -47,6 +50,10 @@ early_initcall(efi_earlycon_remap_fb);
 static int __init efi_earlycon_unmap_fb(void)
 {
 	/* unmap the bootconsole fb unless keep_bootcon left it registered */
+#ifdef CONFIG_BITRA_DTB_SHIM
+	if (efi_fb)
+		return 0;	/* bring-up: permanent console keeps the mapping */
+#endif
 	if (efi_fb && !console_is_registered(earlycon_console))
 		memunmap(efi_fb);
 	return 0;
@@ -273,3 +280,26 @@ static int __init efi_earlycon_setup(struct earlycon_device *device,
 	return 0;
 }
 EARLYCON_DECLARE(efifb, efi_earlycon_setup);
+
+#ifdef CONFIG_BITRA_DTB_SHIM
+/*
+ * Bring-up only: the efifb earlycon is a boot console and is torn down at late init,
+ * which hides everything printed after ~11 s on a phone without UART access.
+ * Register the same writer as a normal console so the panel keeps showing the log.
+ */
+static struct console bitra_efifb_console = {
+	.name	= "bitrafb",
+	.write	= efi_earlycon_write,
+	.flags	= CON_ENABLED,
+	.index	= -1,
+};
+
+static int __init bitra_efifb_console_init(void)
+{
+	if (!efi_fb || !earlycon_console)
+		return 0;
+	register_console(&bitra_efifb_console);
+	return 0;
+}
+late_initcall(bitra_efifb_console_init);
+#endif
-- 
2.56.0


