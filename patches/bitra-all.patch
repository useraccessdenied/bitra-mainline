From d952ec9a35f02236f7ed785e8ed9b8c0c81618f0 Mon Sep 17 00:00:00 2001
From: useraccessdenied <useraccessdenied@users.noreply.github.com>
Date: Sat, 21 Nov 2026 02:21:01 +0530
Subject: [PATCH 05/11] bitra DTS: enable PCIe0 + QCA6390 Wi-Fi, PMU 0.95 V
 rails from pm8150 s6 (smpf2 has no RPMh address here)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 0b42bfb0a..4cf0ffcd0 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -50,8 +50,6 @@ &framebuffer {
 &mdss_dp { status = "disabled"; };
 &gpu { status = "disabled"; };
 &gmu { status = "disabled"; };
-&pcie0 { status = "disabled"; };
-&pcie0_phy { status = "disabled"; };
 &pcie2 { status = "disabled"; };
 &pcie2_phy { status = "disabled"; };
 &pm8150l_flash { status = "disabled"; };
@@ -89,3 +87,13 @@ &pon {
 	mode-bootloader = <0x2>;
 	mode-recovery = <0x1>;
 };
+
+/*
+ * Wi-Fi/BT PMU: the OnePlus tree takes the 0.95 V PMU rails from PM8009 smpf2, which has no RPMh address on this phone
+ * ("could not find RPMh address for resource smpf2"). The stock cnss node powers the chip from pm8150_s6 (aon, 0.95 V),
+ * pm8150_s4 (1.8 V io), pm8150_s5 (1.9 V rfa1) and pm8150a_s8 (1.3 V rfa2): use s6 for the two 0.95 V inputs as well.
+ */
+&qca6390_pmu {
+	vddpmu-supply = <&vreg_s6a_0p95>;
+	vddrfa0p95-supply = <&vreg_s6a_0p95>;
+};
