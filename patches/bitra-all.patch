From 02b0c9d65ac5be5a2090c5eb0ec3afa297ae9a93 Mon Sep 17 00:00:00 2001
From: useraccessdenied <useraccessdenied@users.noreply.github.com>
Date: Sat, 21 Nov 2026 02:48:28 +0530
Subject: [PATCH 7/8] ams662zs01: power the panel down if the PPS transfer
 fails; drop the connector pointer on remove

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-samsung-ams662zs01.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c b/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
index c275bf445..b2cd36d4c 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
@@ -169,6 +169,9 @@ static int ams662zs01_prepare(struct drm_panel *panel)
 	ret = mipi_dsi_picture_parameter_set(ctx->dsi, &pps);
 	if (ret < 0) {
 		dev_err(panel->dev, "failed to transmit PPS: %d\n", ret);
+		/* do not leave the panel powered with an unfinished init */
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ams662zs01_supplies), ctx->supplies);
 		return ret;
 	}
 
@@ -375,6 +378,8 @@ static void ams662zs01_remove(struct mipi_dsi_device *dsi)
 	struct ams662zs01 *ctx = mipi_dsi_get_drvdata(dsi);
 	int ret;
 
+	ctx->connector = NULL;	/* never dereferenced after the panel is unbound */
+
 	ret = mipi_dsi_detach(dsi);
 	if (ret < 0)
 		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
-- 
