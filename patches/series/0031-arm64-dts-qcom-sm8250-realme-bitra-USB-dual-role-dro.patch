From 087f2a47badb0cb0ca356f2f80b248924ff43b54 Mon Sep 17 00:00:00 2001
From: useraccessdenied <useraccessdenied@users.noreply.github.com>
Date: Sun, 22 Nov 2026 22:05:38 +0530
Subject: [PATCH 31/32] arm64: dts: qcom: sm8250-realme-bitra: USB dual-role
 (drop the forced peripheral mode) and the MP2650 OTG enable as the Type-C
 VBUS supply (untested in host mode)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8250-realme-bitra.dts     | 24 +++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 4f9009078..d60a1861c 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -56,10 +56,26 @@ &framebuffer {
 &pcie2_phy { status = "disabled"; };
 &pm8150l_flash { status = "disabled"; };
 
-/* USB: force gadget mode, no Type-C role switch needed for the debug link */
-&usb_1_dwc3 {
-	dr_mode = "peripheral";
-	/delete-property/ usb-role-switch;
+/* USB: dual-role through the PM8150B Type-C port manager (inherited from the OnePlus 8T tree: usb-role-switch on the DWC3). The debug link used to force "peripheral". */
+
+/*
+ * OTG power: on this phone the 5 V VBUS output in host mode comes from the external MP2650 charger (i2c5 @0x5c), switched by the "mps_otg_en"
+ * GPIO (pm8150 gpio3, output high = on; stock realme DT: oplus,mp2650-charger), not from the PM8150B VBUS regulator. The Type-C port manager
+ * only enables it while the phone is a source (Attached.SRC), never while charging from a host. The driver takes it as the deprecated "vdd-vbus" supply.
+ */
+/ {
+	usb_otg_vbus: regulator-usb-otg-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb_otg_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&pm8150_gpios 3 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&pm8150b_typec {
+	vdd-vbus-supply = <&usb_otg_vbus>;
 };
 
 &usb_1_qmpphy {
