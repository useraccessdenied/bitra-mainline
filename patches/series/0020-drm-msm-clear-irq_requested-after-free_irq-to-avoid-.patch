From 4527ced2e750d2be18e4c2a7448bc26aee072f8e Mon Sep 17 00:00:00 2001
From: useraccessdenied <useraccessdenied@users.noreply.github.com>
Date: Sat, 21 Nov 2026 23:06:58 +0530
Subject: [PATCH 20/27] drm/msm: clear irq_requested after free_irq to avoid
 double free

If msm_irq_postinstall() fails, msm_irq_install() frees the irq but leaves
kms->irq_requested set, so msm_drm_kms_uninit() frees it again
(WARN in free_irq). msm_irq_uninstall() also never cleared the flag, and
struct msm_kms outlives a single bind, so a later failed bind saw a stale
flag. Found with failslab fail-nth fault injection.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/msm/msm_kms.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/msm_kms.c b/drivers/gpu/drm/msm/msm_kms.c
index 81056c9cd..47d352a6e 100644
--- a/drivers/gpu/drm/msm/msm_kms.c
+++ b/drivers/gpu/drm/msm/msm_kms.c
@@ -86,6 +86,7 @@ static int msm_irq_install(struct drm_device *dev, unsigned int irq)
 	ret = msm_irq_postinstall(dev);
 	if (ret) {
 		free_irq(irq, dev);
+		kms->irq_requested = false;
 		return ret;
 	}
 
@@ -98,8 +99,10 @@ static void msm_irq_uninstall(struct drm_device *dev)
 	struct msm_kms *kms = priv->kms;
 
 	kms->funcs->irq_uninstall(kms);
-	if (kms->irq_requested)
+	if (kms->irq_requested) {
 		free_irq(kms->irq, dev);
+		kms->irq_requested = false;
+	}
 }
 
 struct msm_vblank_work {
