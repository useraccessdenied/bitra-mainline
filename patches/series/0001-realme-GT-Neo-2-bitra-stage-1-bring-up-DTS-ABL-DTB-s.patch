index d2690c3ec..62820b380 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -87,3 +87,7 @@ endif
 
 # for cleaning
 subdir- += vdso vdso32
