From bead68980030a78a51dd83414d17c17613d12099 Mon Sep 17 00:00:00 2001
From: useraccessdenied <useraccessdenied@users.noreply.github.com>
Date: Sun, 22 Nov 2026 17:21:07 +0530
Subject: [PATCH 25/27] arm64: dts: qcom: sm8250-realme-bitra: enable the
 Adreno 650 GPU and GMU, ZAP shader from the stock vendor firmware

Verified 2026-11-22: turnip (Vulkan 1.3) and freedreno (OpenGL ES, FD650), sway on the gles2 renderer and
weston-simple-egl at 120 fps, GPU frequency scales up to 670 MHz, survives suspend/resume.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 29fb990dc..6ed37bd66 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -50,10 +50,8 @@ &framebuffer {
 	stride = <(1080 * 4)>;
 };
 
-/* Never touch GPU, DP, PCIe2 (modem) or remoteprocs until verified; UFS is enabled for the read-only probe; the display pipeline is enabled for the panel bring-up */
+/* GPU enabled 2026-11-22 (see below); never touch DP, PCIe2 (modem) or remoteprocs until verified; UFS is enabled for the read-only probe; the display pipeline is enabled for the panel bring-up */
 &mdss_dp { status = "disabled"; };
-&gpu { status = "disabled"; };
-&gmu { status = "disabled"; };
 &pcie2 { status = "disabled"; };
 &pcie2_phy { status = "disabled"; };
 &pm8150l_flash { status = "disabled"; };
@@ -157,3 +155,11 @@ fuel_gauge: fuel-gauge@55 {
 &crypto {
 	status = "disabled";
 };
+
+/*
+ * Adreno 650: sqe/gmu come from linux-firmware (qcom/a650_*), the signed ZAP shader is device specific and comes from the stock vendor
+ * firmware of this phone (a650_zap.mdt + .b00-.b02, split MDT layout), installed under /lib/firmware/qcom/sm8250/realme/bitra/.
+ */
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8250/realme/bitra/a650_zap.mdt";
+};
